# 拆声 STEMS · environment
# 复制为 .env 后按需修改

# 平台 Cookie（可选，配置后版权曲/高音质成功率更高）
NETEASE_COOKIE=
QQ_COOKIE=

# 分离设备：auto | cpu | dml | cuda
SEPARATOR_DEVICE=auto
SEPARATOR_WORKERS=1

# 限制
MAX_UPLOAD_MB=200
MAX_AUDIO_MB=150
MAX_DURATION_SEC=900
JOB_TTL_HOURS=24
RATE_LIMIT_PER_MIN=30

# 服务
APP_PORT=8000

# 存储目录（默认 ./storage）
# STORAGE_DIR=storage
# MODELS_DIR=storage/models
